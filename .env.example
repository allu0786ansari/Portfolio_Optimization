# Copy to .env and fill in. Never commit .env (it is git-ignored).
# ---- Data -------------------------------------------------------------
START_DATE=2015-01-01
END_DATE=                     # empty = today (needed for nightly refreshes)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ---- API --------------------------------------------------------------
API_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---- MLflow -----------------------------------------------------------
# Local dev (host):   http://localhost:5000
# Inside compose:     http://mlflow:5000   (set by docker-compose)
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Airflow (generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
TRAINING_SERVICE_API_KEY=change-me-to-a-long-random-string   # must equal API_KEY

# ---- Grafana ------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me
