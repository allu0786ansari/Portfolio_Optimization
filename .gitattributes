# Normalise line endings so the repo works identically on Windows and Linux.
# (Git for Windows converts LF->CRLF on checkout by default; a CRLF shell script
#  copied into a Linux Docker image fails with "$'\r': command not found".)
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.sh        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
*.py        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

*.docx    binary
*.png     binary
*.jpg     binary
*.zip     binary
*.parquet binary
*.pkl     binary
