# .env.example — copy this to .env and fill in real values
# .env is gitignored and must NEVER be committed

# ── API authentication ────────────────────────────────────────────────────────
API_KEY="dev-secret-key-change-me"
API_URL="http://localhost:8000"

# ── Alpaca API (free at alpaca.markets — only needed for live data) ───────────
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key

# ── Data settings ──────────────────────────────────────────────────────────────
START_DATE=2019-01-01
END_DATE=2024-12-31
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Docker secrets (used by docker-compose.yml) ────────────────────────────────
# Grafana admin login — change before any public deployment
GRAFANA_ADMIN_PASSWORD=admin

# Airflow Fernet key — encrypts connection passwords stored in Airflow's metadata DB
# Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=generate-your-own-fernet-key

# Airflow webserver session secret — any random string
AIRFLOW_WEBSERVER_SECRET_KEY=change-this-to-a-random-string

# API key Airflow uses to call FastAPI /retrain/* endpoints — must match API_KEY above
TRAINING_SERVICE_API_KEY=dev-secret-key-change-me
